# Same Mora gateway as enala (values live in enala settings table / maintenance-system .env)
SMS_URL=https://www.mora-sa.com/api/v1/sendsms
SMS_API_KEY=
SMS_USERNAME=
SMS_SENDER=
OTP_SECRET=change-me
# Set to 1 to include code_for_test in the send-otp response
SMS_DEBUG=0

# aff Laravel API (saves spin customers to the dashboard)
AFF_API_URL=http://127.0.0.1:8000/api
AFF_SPIN_API_KEY=spin-aff-local

# nextbrain-whatsapp — uses existing POST /api/v1/messages/send
# Optional: load content from dashboard templates via GET /templates and POST /templates/:id/preview
# Create templates named spin_win / spin_register (or set ids below).
# Win vars: {{customer_name}} {{prize}} {{prize_description}} {{brand_name}}
# Register vars: {{customer_name}} {{entity_label}}
WHATSAPP_API_URL=http://127.0.0.1:3000/api/v1
WHATSAPP_API_KEY=
WHATSAPP_FROM=
WHATSAPP_WIN_TEMPLATE_NAME=spin_win
WHATSAPP_REGISTER_TEMPLATE_NAME=spin_register
# WHATSAPP_WIN_TEMPLATE_ID=
# WHATSAPP_REGISTER_TEMPLATE_ID=
# Fallback text if the templates API is not reachable with this key
# WHATSAPP_WIN_TEMPLATE=مبروك {{customer_name}}! ربحت {{prize}} من {{brand_name}}. {{prize_description}}
# WHATSAPP_REGISTER_TEMPLATE=أهلاً {{customer_name}}، تم تسجيل بياناتك لدى {{entity_label}}. شكراً لزيارتك.
